# ============================================================
# 高校学生管理系统 - 生产环境变量模板
# ============================================================
# 使用方式：
#   cp .env.production.example .env.production
#   vi .env.production   # 逐项修改为生产真实值
# 重要：
#   - 切勿将 .env.production 提交到 Git
#   - JWT_SECRET 必须替换为足够长的随机串（建议 64 字符以上）
#   - 数据库密码必须修改为强密码
# ============================================================

# -------------------- 服务运行 --------------------
NODE_ENV=production
PORT=3000
# 是否启用 Swagger 文档（生产环境建议 false）
ENABLE_SWAGGER=false

# -------------------- 数据库 --------------------
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 若 MySQL 与后端同机部署，主机使用 127.0.0.1
DATABASE_URL="mysql://student_app:StrongProdPassword@127.0.0.1:3306/student_mgmt"

# -------------------- JWT 鉴权 --------------------
# 强烈建议：64 字符以上的随机字符串
# 生成方式：openssl rand -base64 48  或  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# -------------------- 文件存储 --------------------
# local=本地存储，oss=阿里云 OSS
STORAGE_TYPE=local
UPLOAD_DIR=uploads
FILE_MAX_SIZE_MB=20

# OSS 配置（STORAGE_TYPE=oss 时填写）
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# -------------------- 短信 --------------------
# mock=模拟发送（仅日志），aliyun=阿里云短信
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=

# -------------------- CORS 跨域 --------------------
# 生产环境通过 Nginx 同源代理时，可设为空或具体域名
# 若前后端同域（推荐），留空即可
CORS_ORIGIN=

# -------------------- WebSocket --------------------
# 生产环境通过 Nginx 反代时留空（前端使用相对路径）
WS_PUBLIC_URL=

# -------------------- PDF 中文字体 --------------------
# Linux 部署时如未安装中文字体，PDF 中文将显示为方块
# 安装方法（Ubuntu/Debian）：apt-get install fonts-noto-cjk 或 fonts-wqy-zenhei
# 指定字体文件绝对路径（可选）
CHINESE_FONT_PATH=

# -------------------- 数据库备份 --------------------
# mysqldump / mysql 可执行文件路径（容器化 MySQL 时可使用 docker exec）
MYSQL_DUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=30
# 每天 02:00 自动备份
BACKUP_SCHEDULE=0 2 * * *

# -------------------- 日志 --------------------
LOG_LEVEL=info

# -------------------- 服务公网访问地址（可选） --------------------
# 用于 Swagger 文档服务器地址展示，以及部分场景下的回链生成
# 例：http://192.168.1.100  或  https://student.example.edu.cn
PUBLIC_BASE_URL=
