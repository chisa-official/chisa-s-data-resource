# 服务
NODE_ENV=development
PORT=3000

# 数据库
DATABASE_URL="mysql://root:root123456@localhost:3306/student_mgmt"

# JWT
JWT_SECRET=change-me-in-production-please-use-long-random-string
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# 文件存储
STORAGE_TYPE=local
UPLOAD_DIR=uploads
FILE_MAX_SIZE_MB=10

# OSS（STORAGE_TYPE=oss 时启用）
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# 短信
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=

# 数据库备份
MYSQL_DUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# 日志级别
LOG_LEVEL=info
